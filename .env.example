# Server Configuration
# Port for the Hono server (default: 3000)
PORT=3000

# NIS API Configuration
# URL for subscriber search endpoint
NIS_SUBSCRIBER_API_URL=<your-nis-subscriber-api-url>

# URL for ticket creation endpoint
NIS_TICKET_API_URL=<your-nis-ticket-api-url>

# JWT Bearer token for authentication with NIS API
# Required - generate your own token from the transit API provider
NIS_API_TOKEN=<your-jwt-token-here>

# URL for employee lookup endpoint (used as fallback for /regxurl when agent email not in REGXURL_AGENT_EID_MAP)
# Query param: ?email=<agent_email>
# Expected response: { "employee_id": "0201234", "name": "John Doe", "email": "johndoe@example.com" }
NIS_EMPLOYEE_API_URL=<your-nis-employee-api-url>


# Optional: Override server port via SERVER_PORT (alternative to PORT)
# SERVER_PORT=8080

# /regxurl command configuration
# Base URL used to build the registration URL for /regxurl command
REGXURL_BASE_URL=<your-regxurl-base-url>

# Mapping of agent_email to employee ID (EID) in JSON format
# Used to resolve the eid query param from the agent's email
# Example: {"wardi@nusa.net.id":"12345","other@nusa.net.id":"67890"}
REGXURL_AGENT_EID_MAP={"agent@example.com":"00000"}