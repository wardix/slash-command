# Server Configuration
# Port for the Hono server (default: 3000)
PORT=3000

# NIS API Configuration
# URL for subscriber search endpoint
NIS_SUBSCRIBER_API_URL=<your-nis-subscriber-api-url>

# URL for ticket creation endpoint
NIS_TICKET_API_URL=<your-nis-ticket-api-url>

# JWT Bearer token for authentication with NIS API
# Required - generate your own token from the transit API provider
NIS_API_TOKEN=<your-jwt-token-here>

# Response message for /reg slash command
# When user types /reg, this message will be returned as a MESSAGE response
REG_RESPONSE_MESSAGE=Registrasi berhasil

# Optional: Override server port via SERVER_PORT (alternative to PORT)
# SERVER_PORT=8080